# F1 Panopticon Environment Configuration
# Copy this file to .env.local and customize as needed

# API Configuration
# Default API endpoints for F1 data sources
VITE_ERGAST_API_URL=https://ergast.com/api/f1
VITE_OPENF1_API_URL=https://api.openf1.org/v1

# Cache Configuration
# How long to keep cached data (in days)
VITE_CACHE_TTL_DAYS=30

# Maximum cache size in megabytes
VITE_CACHE_MAX_SIZE_MB=500

# Feature Flags
# Enable or disable premium features
VITE_ENABLE_PREMIUM_FEATURES=true

# Enable analytics tracking (optional)
VITE_ENABLE_ANALYTICS=false

# Analytics Configuration (optional)
# Add your analytics ID if VITE_ENABLE_ANALYTICS is true
# VITE_ANALYTICS_ID=your-analytics-id-here

# Error Tracking (optional)
# Add your Sentry DSN for error tracking
# VITE_SENTRY_DSN=your-sentry-dsn-here

# Development Settings
# Enable debug logging in development
VITE_DEBUG_MODE=false

# API rate limiting (requests per second)
VITE_API_RATE_LIMIT=4

# Performance Settings
# Enable adaptive performance optimization
VITE_ADAPTIVE_PERFORMANCE=true

# Minimum bandwidth threshold (Mbps) for full quality
VITE_MIN_BANDWIDTH_MBPS=5

# Visualization Settings
# Default number of telemetry channels in dashboard
VITE_DEFAULT_CHANNELS=6

# Maximum number of laps to overlay
VITE_MAX_LAP_OVERLAY=4

# Chart update frequency (milliseconds)
VITE_CHART_UPDATE_INTERVAL=100

# Session Replay Settings
# Default playback speed
VITE_DEFAULT_PLAYBACK_SPEED=1.0

# Maximum playback speed
VITE_MAX_PLAYBACK_SPEED=16.0

# Minimum playback speed
VITE_MIN_PLAYBACK_SPEED=0.25

# Export Settings
# Default image export resolution
VITE_EXPORT_IMAGE_WIDTH=1920
VITE_EXPORT_IMAGE_HEIGHT=1080

# Maximum export resolution (4K)
VITE_MAX_EXPORT_WIDTH=3840
VITE_MAX_EXPORT_HEIGHT=2160

# PDF export page size (A4, Letter, etc.)
VITE_PDF_PAGE_SIZE=A4

# Accessibility Settings
# Enable high contrast mode by default
VITE_HIGH_CONTRAST_MODE=false

# Enable screen reader announcements
VITE_SCREEN_READER_ENABLED=true

# Keyboard shortcuts enabled by default
VITE_KEYBOARD_SHORTCUTS_ENABLED=true

# Security Settings
# Content Security Policy (for production)
# VITE_CSP_ENABLED=true

# Notes:
# - All VITE_ prefixed variables are exposed to the client
# - Never commit sensitive API keys to version control
# - Use .env.local for local development (not tracked by git)
# - Use .env.production for production builds
